---
import NewsletterSignup from '@components/NewsletterSignup.astro';

/**
 * Welcome popup shown to new visitors, inviting them onto the email list with
 * the free-pastry offer. Rendered once site-wide from Base.astro.
 *
 * Behavior (tune the two constants in the inline script below):
 *   • Appears ~1.5s after the page paints (DELAY_MS).
 *   • If dismissed, it stays hidden for 14 days (SUPPRESS_DAYS) so we never nag
 *     the same person on every click.
 *   • Once someone subscribes (from ANY signup form), it never shows again.
 * Accessible: role="dialog", Esc to close, backdrop click to close, focus moves
 * to the email field on open and returns to the trigger on close, page scroll
 * is locked while it's open.
 */
---

<div
  id="welcome-popup"
  class="fixed inset-0 z-[200] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="welcome-popup-title"
  aria-describedby="welcome-popup-desc"
>
  <div id="welcome-popup-backdrop" class="absolute inset-0 bg-ink/60 backdrop-blur-sm"></div>

  <div class="relative w-full max-w-md overflow-hidden rounded-xl2 bg-cream shadow-lift ring-1 ring-ink/10">
    <button
      id="welcome-popup-close"
      type="button"
      aria-label="Close"
      class="absolute right-3 top-3 z-10 grid h-9 w-9 place-items-center rounded-full bg-cream/90 text-ink/70 shadow-card transition hover:bg-cream hover:text-ink"
    >
      <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>

    <div class="relative bg-forest px-6 pb-8 pt-7 text-cream">
      <div class="pointer-events-none absolute inset-0 opacity-20" aria-hidden="true">
        <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-gold blur-2xl"></div>
        <div class="absolute -bottom-12 -left-8 h-40 w-40 rounded-full bg-wine blur-3xl"></div>
      </div>
      <p class="eyebrow mb-2" style="color:var(--gold)">A little welcome gift</p>
      <h2 id="welcome-popup-title" class="font-display text-3xl font-semibold text-cream">
        Free pastry, on us
      </h2>
    </div>

    <div class="px-6 py-6">
      <p id="welcome-popup-desc" class="text-ink/80">
        Join Antonio&rsquo;s email list and enjoy a <strong>free Izzy&rsquo;s Bakery pastry</strong> with any
        sandwich, sub, or meal. We&rsquo;ll send the offer straight to your inbox &mdash; just show it at the
        counter.
      </p>

      <div class="mt-4">
        <NewsletterSignup formId="signup-popup" buttonLabel="Get My Free Pastry" />
      </div>

      <p class="mt-3 text-xs text-ink/55">
        One per customer. We&rsquo;ll email occasional specials &mdash; unsubscribe anytime.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY_DISMISS = 'antonios_popup_dismissed';
    var KEY_SUB = 'antonios_subscribed';
    var DELAY_MS = 1500; // wait before showing, so the page paints first
    var SUPPRESS_DAYS = 14; // how long a dismissal keeps the popup hidden

    var popup = document.getElementById('welcome-popup');
    if (!popup) return;
    var backdrop = document.getElementById('welcome-popup-backdrop');
    var closeBtn = document.getElementById('welcome-popup-close');
    var lastFocused = null;

    function get(k) { try { return localStorage.getItem(k); } catch (_) { return null; } }
    function set(k, v) { try { localStorage.setItem(k, v); } catch (_) {} }

    function suppressed() {
      if (get(KEY_SUB)) return true;
      var t = get(KEY_DISMISS);
      if (!t) return false;
      return (Date.now() - parseInt(t, 10)) / 86400000 < SUPPRESS_DAYS;
    }

    function onKey(e) { if (e.key === 'Escape') close(true); }

    function open() {
      lastFocused = document.activeElement;
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      document.body.style.overflow = 'hidden';
      var email = document.getElementById('signup-popup-email');
      if (email) setTimeout(function () { email.focus(); }, 50);
      document.addEventListener('keydown', onKey);
    }

    function close(markDismiss) {
      popup.classList.add('hidden');
      popup.classList.remove('flex');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      if (markDismiss) set(KEY_DISMISS, String(Date.now()));
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    if (closeBtn) closeBtn.addEventListener('click', function () { close(true); });
    if (backdrop) backdrop.addEventListener('click', function () { close(true); });

    // Auto-close a moment after a successful signup (from this or any form).
    document.addEventListener('antonios:subscribed', function () {
      setTimeout(function () { if (!popup.classList.contains('hidden')) close(false); }, 2500);
    });

    if (!suppressed()) {
      setTimeout(function () { if (!suppressed()) open(); }, DELAY_MS);
    }
  })();
</script>
