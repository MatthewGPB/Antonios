---
/**
 * Lowkey Family Dinner side tab. A slim tab pinned to the right edge that the
 * visitor can open to see the deal — it never auto-opens, so it stays quiet.
 * Rendered site-wide from Base.astro.
 *
 * On desktop the panel opens beside the tab (right, vertically centered); on
 * mobile it opens as a bottom card. Esc or the × collapses it back to the tab.
 *
 * To retire it: remove <FamilyDinnerTab /> from Base.astro (or delete this file).
 */
---

<!-- Collapsed tab -->
<button
  id="fd-tab"
  type="button"
  aria-expanded="false"
  aria-controls="fd-panel"
  class="fixed right-0 top-1/2 z-[45] -translate-y-1/2 rounded-l-xl border border-r-0 border-gold/40 bg-forest px-2 py-4 text-cream shadow-lift transition hover:bg-[#1b4433]"
>
  <span class="flex flex-col items-center gap-2.5">
    <span class="h-2 w-2 rounded-full bg-gold" aria-hidden="true"></span>
    <span class="text-[11px] font-semibold uppercase tracking-[0.22em] [writing-mode:vertical-rl] rotate-180">Family&nbsp;Dinner</span>
  </span>
</button>

<!-- Expanded panel -->
<div
  id="fd-panel"
  role="dialog"
  aria-label="Family Dinner offer"
  class="fixed z-[45] hidden inset-x-4 bottom-4 overflow-hidden rounded-xl2 bg-cream shadow-lift ring-1 ring-ink/10 sm:inset-x-auto sm:bottom-auto sm:right-4 sm:top-1/2 sm:w-[340px] sm:-translate-y-1/2"
>
  <div class="relative bg-forest px-5 pb-4 pt-4 text-cream">
    <button
      id="fd-close"
      type="button"
      aria-label="Close"
      class="absolute right-2 top-2 grid h-7 w-7 place-items-center rounded-full text-cream/70 transition hover:bg-cream/15 hover:text-cream"
    >
      <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
    <p class="eyebrow mb-1" style="color:var(--gold)">New</p>
    <h2 class="font-display text-2xl font-semibold text-cream">Family Dinner</h2>
  </div>

  <div class="px-5 py-4">
    <p class="text-sm text-ink/80">A complete Italian dinner &mdash; <strong>serves 4</strong>.</p>
    <p class="mt-2 text-sm leading-relaxed text-ink/70">
      Baguette &middot; Garden or Caesar salad &middot; Chicken or Eggplant Parm &middot; Tiramisu
    </p>

    <div class="mt-4 flex items-stretch gap-3">
      <div class="flex-1 rounded-lg bg-forest/5 px-3 py-2 text-center ring-1 ring-ink/10">
        <div class="text-[10px] font-semibold uppercase tracking-wider text-wine">Pickup</div>
        <div class="font-display text-xl font-semibold text-forest">$49.99</div>
      </div>
      <div class="flex-1 rounded-lg bg-forest/5 px-3 py-2 text-center ring-1 ring-ink/10">
        <div class="text-[10px] font-semibold uppercase tracking-wider text-wine">Delivery</div>
        <div class="font-display text-xl font-semibold text-forest">$59.99</div>
      </div>
    </div>

    <a href="tel:+15616256544" class="btn-gold mt-4 w-full">Call to Order</a>
    <p class="mt-2 text-center text-sm font-semibold text-forest">(561) 625-6544</p>
    <p class="mt-1 text-center text-[11px] text-ink/50">Substitutions available &mdash; just ask.</p>
  </div>
</div>

<script is:inline>
  (function () {
    var tab = document.getElementById('fd-tab');
    var panel = document.getElementById('fd-panel');
    var closeBtn = document.getElementById('fd-close');
    if (!tab || !panel) return;

    function onKey(e) { if (e.key === 'Escape') collapse(); }

    function expand() {
      panel.classList.remove('hidden');
      tab.classList.add('hidden');
      tab.setAttribute('aria-expanded', 'true');
      document.addEventListener('keydown', onKey);
      if (closeBtn) closeBtn.focus();
    }

    function collapse() {
      panel.classList.add('hidden');
      tab.classList.remove('hidden');
      tab.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKey);
      tab.focus();
    }

    tab.addEventListener('click', expand);
    if (closeBtn) closeBtn.addEventListener('click', collapse);
  })();
</script>
