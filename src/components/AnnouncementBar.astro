---
/**
 * Top-of-site announcement bar. Sits above the sticky header (scrolls away on
 * scroll while the header stays). The message links somewhere; dismissible, and
 * a dismissal is remembered via localStorage so it won't nag repeat visitors.
 *
 * To retire it: remove <AnnouncementBar /> from Base.astro (or delete this file).
 * To run a different promo later, change the copy/href below and bump the KEY in
 * the script so past dismissals don't hide the new message.
 */
---

<div id="announcement-bar" class="border-b border-black/10 bg-wine text-cream">
  <div class="container-x relative flex min-h-[40px] items-center justify-center py-2 pr-9 text-center">
    <a href="/bakery" class="group text-[13px] font-medium leading-snug sm:text-sm">
      <span class="font-semibold underline-offset-2 group-hover:underline">Try Izzy&rsquo;s Bakery</span><span class="text-cream/85"> &mdash; fresh sourdough, pastries &amp; sweets, baked daily.</span>
      <span aria-hidden="true" class="ml-1 inline-block transition group-hover:translate-x-0.5">&rarr;</span>
    </a>
    <button
      id="announcement-close"
      type="button"
      aria-label="Dismiss announcement"
      class="absolute right-2 top-1/2 grid h-7 w-7 -translate-y-1/2 place-items-center rounded-full text-cream/70 transition hover:bg-cream/15 hover:text-cream"
    >
      <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'antonios_announce_izzys_2026';
    var bar = document.getElementById('announcement-bar');
    if (!bar) return;
    try { if (localStorage.getItem(KEY)) { bar.remove(); return; } } catch (e) {}
    var btn = document.getElementById('announcement-close');
    if (btn) btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      bar.remove();
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });
  })();
</script>
