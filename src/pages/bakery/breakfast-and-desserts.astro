---
// This page's content was merged into /bakery. Kept as a redirect stub so the
// old URL keeps working, and so uploading over the old file (GitHub "Upload
// files" does not delete removed files) replaces it with this redirect.
const dest = '/bakery';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
    <link rel="canonical" href={dest} />
    <meta name="robots" content="noindex, follow" />
    <title>Page moved — Izzy's Bakery</title>
  </head>
  <body>
    <p>This page has moved. <a href={dest}>Continue to Izzy's Bakery</a>.</p>
    <script is:inline>window.location.replace('/bakery');</script>
  </body>
</html>
