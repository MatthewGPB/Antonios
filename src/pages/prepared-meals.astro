---
// This page's content was merged into /menu. Kept as a redirect stub so the
// old URL keeps working, and so uploading over the old file (GitHub "Upload
// files" does not delete removed files) replaces it with this redirect.
const dest = '/menu';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
    <link rel="canonical" href={dest} />
    <meta name="robots" content="noindex, follow" />
    <title>Page moved — our menu</title>
  </head>
  <body>
    <p>This page has moved. <a href={dest}>Continue to our menu</a>.</p>
    <script is:inline>window.location.replace('/menu');</script>
  </body>
</html>
